{
  "name": "@liblaf/github-bot",
  "version": "0.1.7",
  "description": "",
  "keywords": [],
  "homepage": "https://github.com/liblaf/github-bot",
  "bugs": {
    "url": "https://github.com/liblaf/github-bot/issues"
  },
  "license": "MIT",
  "author": {
    "name": "liblaf",
    "email": "30631553+liblaf@users.noreply.github.com",
    "url": "https://github.com/liblaf"
  },
  "repository": "github:liblaf/github-bot",
  "funding": {
    "type": "github",
    "url": "https://github.com/liblaf/github-bot?sponsor=1"
  },
  "bin": {},
  "files": [
    "dist"
  ],
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "bunup",
    "dev": "wrangler dev --port 8787",
    "dev-proxy": "smee --port 8787 --path '/api/github/webhooks'",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "generate-types": "wrangler types --env-file '.dev.vars.example' --env-interface 'CloudflareBindings'",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepack": "bun run build",
    "prepare": "bun run generate-types",
    "type-check": "tsc --noEmit",
    "update": "bun update --latest && bun install"
  },
  "dependencies": {
    "@octokit/webhooks": "^14.2.0",
    "hono": "^4.13.5",
    "octokit": "^5.0.5"
  },
  "devDependencies": {
    "@liblaf/config": "0.3.2",
    "@types/node": "26.4.1",
    "bunup": "0.16.32",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "smee-client": "5.0.0",
    "typescript": "7.0.2",
    "wrangler": "4.128.0"
  },
  "readme": "./README.md"
}
